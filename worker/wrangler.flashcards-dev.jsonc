{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bloggersaas-ai-proxy-v514-dev",
  "main": "./worker/flashcards-ai-dev-worker.js",
  "compatibility_date": "2026-08-08",
  "workers_dev": true,
  "preview_urls": false,

  "vars": {
    "FLASHCARDS_ALLOWED_ORIGIN": "https://freeunlimitedmultitools.blogspot.com",
    "GEMINI_MODEL": "gemini-3.5-flash"
  },

  "unsafe": {
    "bindings": [
      {
        "name": "FLASHCARDS_LIMITER",
        "type": "ratelimit",
        "namespace_id": "2002",
        "simple": {
          "limit": 5,
          "period": 60
        }
      }
    ]
  },

  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false,
      "head_sampling_rate": 0
    }
  }
}
