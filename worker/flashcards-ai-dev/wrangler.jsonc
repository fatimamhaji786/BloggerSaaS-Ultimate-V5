{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "bloggersaas-ai-proxy-v514-dev",
  "main": "../worker/flashcards-ai-dev-worker.js",
  "compatibility_date": "2026-08-08",
  "workers_dev": true,
  "vars": {
    "FLASHCARDS_ALLOWED_ORIGIN": "https://freeunlimitedmultitools.blogspot.com",
    "GEMINI_MODEL": "gemini-3.5-flash"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  }
}
